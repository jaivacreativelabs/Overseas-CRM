PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/jaiva_crm
JWT_SECRET=overseas_crm_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# WhatsApp Cloud API (Meta) - sends a WhatsApp alongside lifecycle emails
WHATSAPP_ACCESS_TOKEN=          # WhatsApp > API Setup token (temporary = 24h; use a System User token for production)
WHATSAPP_PHONE_NUMBER_ID=       # "Phone Number ID" shown under the sending number in API Setup
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91  # prefixed to 10-digit lead phone numbers
WHATSAPP_TEMPLATE_LANGUAGE=en_US  # language code of your approved templates (must match the template, e.g. en_US)
WHATSAPP_TEMPLATE_DOCUMENT_REQUESTED=document_request  # approved template for document requests; body {{1}}=name {{2}}=document {{3}}=portal link (hello_world = Meta test template, no variables)
WHATSAPP_DRY_RUN=false          # true = log the message instead of sending it
